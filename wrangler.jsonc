// Cloudflare Workers config: serves the built site in ./dist as static files.
// No server code runs, so there is nothing to bill beyond the free plan.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visionbuilders",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
