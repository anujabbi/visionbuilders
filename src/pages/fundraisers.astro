---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { imageSize } from '../lib/files';
import { FUNDRAISERS } from '../data/site';

// Edited in Pages CMS (src/content/fundraisers.json). Listed in the order given there.
const events = FUNDRAISERS.map((e) => ({
  ...e,
  link: e.button_link ? { href: e.button_link, label: e.button_text || 'Learn more' } : undefined,
  pics: e.photos || [],
}));
---
<Base title="Fundraisers" description="Concerts, marathons and campaigns that friends of Vision Builders have run for Kutumb and NIPUN.">
  <section class="page-head">
    <div class="wrap narrow">
      <h1>Fundraisers</h1>
      <p class="lede">Friends of Vision Builders have run concerts, shows, marathons and online campaigns for the children and families we support. Thank you to everyone who took part.</p>
      <p class="small">Want to run your own fundraiser? Email <a href="mailto:info@visionbuilders.org">info@visionbuilders.org</a> and we’ll help.</p>
    </div>
  </section>

  {events.map((e, i) => (
    <section class:list={['sec', { 'sec-alt': i % 2 === 0 }]}>
      <div class="wrap">
        <div class="narrow" style="margin:0">
          <h2>{e.title}</h2>
          <p class="where">{e.when}</p>
          <p>{e.text}</p>
          {e.link && <a class="btn btn-primary" href={e.link.href} rel="noopener">{e.link.label}</a>}
        </div>
        {e.pics.length > 0 && (
          <div class="gallery">
            {e.pics.map((src, n) => {
              const size = imageSize(src);
              const tall = size.width && size.height && size.height > size.width * 1.15;
              return <a href={src} class:list={{ tall }}><img src={src} alt={`${e.title}, photo ${n + 1}`} loading="lazy" {...size} /></a>;
            })}
          </div>
        )}
      </div>
    </section>
  ))}

  <Cta />
</Base>
