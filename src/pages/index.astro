---
import Base from '../layouts/Base.astro';
import Stats from '../components/Stats.astro';
import Cta from '../components/Cta.astro';
import FacebookFeed from '../components/FacebookFeed.astro';
import { IMPACT_2026, HOME } from '../data/site';

const why = HOME.why.map((w) => [w.title, w.text]);

---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-media">
        <img src="/images/kids.jpg" alt="Children at NIPUN’s education centre in Delhi" width="1088" height="1249" fetchpriority="high" />
      </div>
      <div>
        <h1>{HOME.headline}</h1>
        <p class="lede">{HOME.intro}</p>
        <div class="actions">
          <a class="btn btn-primary" href="/donate/">Donate</a>
          <a class="btn btn-ghost" href="/newsletter/">Read the 2026 newsletter</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Why give with Vision Builders</h2>
      <div class="why">
        {why.map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap">
      <h2>What your donations achieved in {HOME.impact_year}</h2>
      <p class="intro">{HOME.impact_note}</p>
      <Stats items={IMPACT_2026} />
      <a class="more" href="/newsletter/">See the full 2026 newsletter</a>
    </div>
  </section>

  <section class="sec">
    <div class="wrap partners">
      <h2>Our partners</h2>
      <article class="partner">
        <img src="/images/kathak.jpg" alt="Kutumb children performing Kathak on the ghats of Varanasi" width="420" height="315" loading="lazy" />
        <div>
          <h3>Kutumb, Varanasi</h3>
          <p class="where">Since 2002</p>
          <p>Kutumb means family. It began by giving children from Varanasi’s railway platforms a home and schooling. Today it also runs Clinic on Wheels for villages with no doctor, sewing centres in 15 villages and a music and dance school.</p>
          <a class="more" href="/kutumb/">More about Kutumb</a>
        </div>
      </article>
      <article class="partner">
        <img src="/images/computer.jpg" alt="Young women in a NIPUN computer class" width="1280" height="960" loading="lazy" />
        <div>
          <h3>NIPUN, New Delhi</h3>
          <p class="where">Since 2005</p>
          <p>NIPUN works in the slum communities of West and South-West Delhi. We fund job training, hot meals for children, local teachers and scholarships for girls.</p>
          <a class="more" href="/nipun/">More about NIPUN</a>
        </div>
      </article>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap">
      <h2>From the field</h2>
      <p class="intro">The latest posts from our Facebook pages.</p>
      <FacebookFeed />
    </div>
  </section>

  <Cta />
</Base>
