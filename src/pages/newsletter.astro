---
import Base from '../layouts/Base.astro';
import { NEWSLETTERS } from '../data/site';

// Edited in Pages CMS (src/content/newsletters.json). Newest year first.
const issues = NEWSLETTERS.map((i) => ({ year: String(i.year), pages: i.pages || [] }));
const latest = issues[0]?.year;
---
<Base title="Annual newsletters" description="Vision Builders’ annual newsletters: results from Kutumb in Varanasi and NIPUN in New Delhi.">
  <section class="page-head">
    <div class="wrap narrow">
      <h1>Annual newsletters</h1>
      <p class="lede">Every year we share what your donations achieved through our partners, Kutumb in Varanasi and NIPUN in New Delhi.</p>
      <nav class="year-jump" aria-label="Newsletters by year">
        <span>Jump to:</span>
        {issues.map((i) => <a href={`#nl-${i.year}`}>{i.year}</a>)}
      </nav>
    </div>
  </section>

  <section class="sec" style="padding-top:16px">
    <div class="wrap narrow">
      <p class="small">Tap a page to see it full size.</p>
      {issues.map((issue) => (
        <details class="issue" id={`nl-${issue.year}`} open={issue.year === latest}>
          <summary>{issue.year} Annual Newsletter</summary>
          <div class="pages">
            {issue.pages.map((src, n) => (
              <a href={src}><img src={src} alt={`${issue.year} newsletter, page ${n + 1}`} loading={issue.year === latest && n === 0 ? 'eager' : 'lazy'} width="1100" height="1424" /></a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>
</Base>

<script>
  // Opening a year from the "Jump to" links expands it.
  const openFromHash = () => {
    const el = location.hash && document.querySelector<HTMLDetailsElement>(location.hash);
    if (el && el.tagName === 'DETAILS') el.open = true;
  };
  window.addEventListener('hashchange', openFromHash);
  openFromHash();
</script>
